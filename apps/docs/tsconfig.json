{
	"extends": ["../../tsconfig.json", "./.implement/tsconfig.json"],
	"compilerOptions": {
		"types": ["node", "vite/client"],
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"],
			"@tutorial/test": ["./src/lib/tutorial-test.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"*.config.ts",
		".velite/**/*.d.ts",
		".implement/**/*.ts",
		".implement/types/**/*.d.ts"
	]
}
