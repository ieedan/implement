{
	"name": "@demos/tracker",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm generate && concurrently -n web,api -c cyan,blue \"vite\" \"pnpm dev:api\"",
		"dev:api": "tsx watch server/index.ts",
		"generate": "openapi-ts",
