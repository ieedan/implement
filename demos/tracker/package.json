		"check": "pnpm generate && tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@hono/zod-openapi": "^1.6.0",
		"@implementjs/core": "workspace:*",
		"hono": "^4.13.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.0.0-next-20260813201118",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^7.3.0"
	}
