{
	"name": "ui-framework",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "concurrently \"pnpm dev:lib\" \"pnpm dev:css\" \"pnpm dev:www\"",
		"dev:lib": "tsdown --watch",
		"dev:css": "tailwindcss -i ./app.css -o ./dist/app.css --watch",
		"dev:www": "pnpx serve",
		"build": "tsdown && pnpm build:css",
		"build:css": "tailwindcss -i ./app.css -o ./dist/app.css --minify",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.32.1",
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.4",
		"fast-deep-equal": "^3.1.3",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	}
}
