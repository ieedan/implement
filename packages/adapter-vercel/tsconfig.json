{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
	// The fixture app resolves `./$types` through the generated
	// `.implement/tsconfig.json`, which this config knows nothing about.
	"exclude": ["tests/fixtures"]
}
