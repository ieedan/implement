{
	"name": "@implementjs/core",
	"version": "0.0.6",
	"description": "Signals, element helpers and the pieces nodes are built out of, for implement. Plain TypeScript that builds real DOM nodes, no compiler.",
	"keywords": [
		"implement",
		"implementjs",
		"signals",
		"reactivity",
		"dom",
		"router",
		"ui",
		"frontend"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/docs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./hydrate": {
			"types": "./src/hydrate.ts",
			"default": "./src/hydrate.ts"
		},
		"./elements": {
			"types": "./src/components/elements.ts",
			"default": "./src/components/elements.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"default": "./src/server/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./hydrate": {
				"types": "./dist/hydrate.d.mts",
				"default": "./dist/hydrate.mjs"
			},
			"./elements": {
				"types": "./dist/components/elements.d.mts",
				"default": "./dist/components/elements.mjs"
			},
			"./server": {
				"types": "./dist/server/index.d.mts",
				"default": "./dist/server/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"seed": "node --experimental-strip-types scripts/seed-components.ts",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"test": "vitest run"
	},
	"dependencies": {
		"fast-deep-equal": "^3.1.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"happy-dom": "^20.0.11",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	}
}
