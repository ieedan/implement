{
	"name": "@implementjs/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./elements": {
			"types": "./src/components/elements.ts",
			"default": "./src/components/elements.ts"
		},
		"./router": {
			"types": "./src/router/index.ts",
			"default": "./src/router/index.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"default": "./src/server/index.ts"
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"seed": "node --experimental-strip-types scripts/seed-components.ts",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"fast-deep-equal": "^3.1.3",
		"happy-dom": "^20.0.11",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	}
}
