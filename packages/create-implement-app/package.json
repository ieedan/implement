{
	"name": "create-implement-app",
	"version": "0.0.3",
	"description": "Scaffolds a new implement app: kit or plain Vite, with Tailwind, primitives, icons, forms and dark mode as optional addons.",
	"keywords": [
		"implement",
		"implementjs",
		"create",
		"scaffold",
		"cli",
		"starter",
		"template"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/create",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/create-implement-app"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"bin": "./dist/bin.mjs",
	"files": [
		"dist/**/*",
		"!dist/**/*.map"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"start": "node ./dist/bin.mjs",
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@types/node": "^26.2.0",
		"dedent": "^1.7.1",
		"nevereverthrow": "^0.3.0",
		"package-manager-detector": "^1.8.0",
		"pathe": "^2.0.3",
		"picocolors": "^1.1.1",
		"tinyexec": "^1.3.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18",
		"zod": "^4.4.3"
	}
}
