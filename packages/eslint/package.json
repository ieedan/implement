{
	"name": "@implementjs/eslint",
	"version": "0.0.1",
	"description": "Lint rules for the implement mistakes types cannot catch. An ESLint plugin, and oxlint runs it too.",
	"keywords": [
		"implement",
		"implementjs",
		"eslint",
		"eslintplugin",
		"oxlint",
		"lint"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/eslint",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/eslint"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"aria-query": "^5.3.2"
	},
	"devDependencies": {
		"@types/aria-query": "^5.0.4",
		"@types/estree": "^1.0.9",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"oxlint": "^1.78.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18"
	}
}
