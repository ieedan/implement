{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		// oxlint loads `src/index.ts` through Node's ESM resolver, which does not
		// guess at extensions the way a bundler does — so every relative import
		// in this package spells one out.
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
