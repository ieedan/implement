{
	"name": "@implementjs/formish",
	"version": "0.0.3",
	"description": "Schema first forms for implement. The schema types the fields, validates the input and produces the submit handler's output.",
	"keywords": [
		"implement",
		"implementjs",
		"forms",
		"validation",
		"standard-schema",
		"valibot",
		"zod",
		"arktype"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/formish",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/formish"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@implementjs/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"happy-dom": "^20.0.11",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"valibot": "^1.4.1",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	}
}
