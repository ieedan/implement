{
	"name": "@implementjs/kit",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"implement-kit": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./client/neverthrow": {
			"types": "./src/client-neverthrow.ts",
			"default": "./src/client-neverthrow.ts"
		},
		"./endpoint": {
			"types": "./src/endpoint.ts",
			"default": "./src/endpoint.ts"
		},
		"./adapter": {
			"types": "./src/adapter.ts",
			"default": "./src/adapter.ts"
		},
		"./handler": {
			"types": "./src/handler.ts",
			"default": "./src/handler.ts"
		},
		"./openapi": {
			"types": "./src/openapi.ts",
			"default": "./src/openapi.ts"
		},
		"./node": {
			"types": "./src/node.ts",
			"default": "./src/node.ts"
		},
		"./server": {
			"types": "./src/server.ts",
			"default": "./src/server.ts"
		},
		"./runtime": {
			"types": "./src/runtime.ts",
			"default": "./src/runtime.ts"
		},
		"./sync": {
			"types": "./src/sync.ts",
			"default": "./src/sync.ts"
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"prepare": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@implementjs/core": "workspace:*",
		"@implementjs/vite": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"esbuild": "^0.28.2"
	},
	"peerDependencies": {
		"neverthrow": "^8.0.0",
		"vite": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"neverthrow": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@valibot/to-json-schema": "^1.7.1",
		"neverthrow": "^8.2.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"valibot": "^1.4.2",
		"vite": "^7.3.0",
		"vitest": "^4.0.18",
		"zod": "^4.4.3"
	}
}
