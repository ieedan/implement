{
	"name": "@implementjs/kit",
	"version": "0.0.13",
	"description": "File based routing, server rendering and prerendering for implement apps, on top of Vite.",
	"keywords": [
		"implement",
		"implementjs",
		"kit",
		"vite",
		"ssr",
		"routing",
		"prerender",
		"fullstack"
	],
	"license": "MIT",
