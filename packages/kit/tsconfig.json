{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// `vite/client` for the ambient `import.meta.env` core's source reads, the
		// same reason every other package that compiles it declares this.
		"types": ["node", "vite/client"],
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
	// Fixture apps use kit aliases (`@/lib`, `$lib`) that only exist in the
	// generated `.implement/tsconfig.json`, not this package's config.
	"exclude": ["tests/fixtures"]
}
