{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
	// Fixture apps use kit aliases (`@/lib`, `$lib`) that only exist in the
	// generated `.implement/tsconfig.json`, not this package's config.
	"exclude": ["tests/fixtures"]
}
