{
	"name": "@implementjs/lucide",
	"version": "0.1.0-alpha.0",
	"description": "The Lucide icon set as implement components. One module per icon, so bundlers keep only what you import.",
	"keywords": [
		"implement",
		"implementjs",
		"lucide",
		"icons",
		"svg"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/lucide",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/lucide"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "pnpm generate && tsdown --watch",
		"build": "pnpm generate && tsdown",
		"generate": "node --experimental-strip-types scripts/generate-icons.ts",
		"check": "pnpm generate && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
	},
	"dependencies": {
		"@implementjs/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"lucide-static": "^1.33.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^7.3.0"
	}
}
