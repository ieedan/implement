{
	"name": "@implementjs/primitives",
	"version": "0.0.8",
	"description": "Unstyled, accessible building blocks for implement. They own the behavior and the accessibility, you own the look.",
	"keywords": [
		"implement",
		"implementjs",
		"primitives",
		"headless",
		"accessibility",
		"components",
		"ui"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/primitives",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/primitives"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@implementjs/core": "workspace:*"
	},
	"devDependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@types/node": "^26.2.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	}
}
