{
	"name": "@implementjs/router",
	"version": "0.0.10",
	"description": "The typed route-tree router for implement. Params as signals, persistent layouts, typed links and URL-synced search params.",
	"keywords": [
		"implement",
		"implementjs",
		"router",
		"routing",
		"navigation",
		"spa",
		"ui",
		"frontend"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/docs/router",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/router"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@implementjs/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"happy-dom": "^20.0.11",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	}
}
