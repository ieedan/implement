{
	"name": "@implementjs/vite",
	"version": "0.0.1",
	"description": "The Vite plugin behind implement's server rendering, prerendering and dev styles.",
	"keywords": [
		"implement",
		"implementjs",
		"vite",
		"vite-plugin",
		"ssr",
		"prerender"
	],
	"license": "MIT",
	"author": "Aidan Bleser",
	"homepage": "https://implementjs.dev/docs/vite",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/implement.git",
		"directory": "packages/vite"
	},
	"bugs": {
		"url": "https://github.com/ieedan/implement/issues"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./inject": {
			"types": "./src/inject.ts",
			"default": "./src/inject.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./inject": {
				"types": "./dist/inject.d.mts",
				"default": "./dist/inject.mjs"
			}
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"vite": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vite": "^7.3.0",
		"vitest": "^4.0.18"
	}
}
