{
	"$schema": "https://getbizi.dev/schemas/task.config.json",
	"tasks": {
		"dev": {
			"tasks": {
				"lib": {
					"color": "blue",
					"command": "pnpm --filter @packages/ui dev"
				},
				"todo": {
					"tasks": {
						"js": {
							"color": "cyan",
							"command": "pnpm --filter @demos/todo dev:js"
						},
						"css": {
							"color": "magenta",
							"command": "pnpm --filter @demos/todo dev:css"
						},
						"www": {
							"color": "green",
							"command": "pnpm --filter @demos/todo dev:www"
						}
					}
				},
				"kitchen": {
					"optional": true,
					"tasks": {
						"js": {
							"color": "yellow",
							"command": "pnpm --filter @demos/kitchen dev:js"
						},
						"css": {
							"color": "white",
							"command": "pnpm --filter @demos/kitchen dev:css"
						},
						"www": {
							"color": "red",
							"command": "pnpm --filter @demos/kitchen dev:www"
						}
					}
				}
			}
		},
		"ci": {
			"tasks": {
				"format": {
					"command": "pnpm format"
				},
				"lint": {
					"command": "pnpm lint",
					"dependsOn": ["ci:format"]
				},
				"check": {
					"command": "pnpm check",
					"dependsOn": ["ci:lint"]
				}
			}
		}
	}
}
