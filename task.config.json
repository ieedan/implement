{
	"$schema": "https://getbizi.dev/schemas/task.config.json",
	"tasks": {
		"dev": {
			"tasks": {
				"lib": {
					"color": "blue",
					"command": "pnpm --filter @implementjs/core dev"
				},
				"todo": {
					"tasks": {
						"generate": {
							"color": "white",
							"command": "pnpm --filter @demos/todo generate"
						},
						"js": {
							"color": "cyan",
							"command": "pnpm --filter @demos/todo dev:js",
							"dependsOn": ["dev:todo:generate"]
						},
						"css": {
							"color": "magenta",
							"command": "pnpm --filter @demos/todo dev:css"
						},
						"www": {
							"color": "green",
							"command": "pnpm --filter @demos/todo dev:www"
						},
						"api": {
							"color": "blue",
							"command": "pnpm --filter @demos/todo dev:api"
						}
					}
				},
				"tracker": {
					"optional": true,
					"tasks": {
						"js": {
							"color": "cyan",
							"command": "pnpm --filter @demos/tracker dev:js"
						},
						"css": {
							"color": "magenta",
							"command": "pnpm --filter @demos/tracker dev:css"
						},
						"www": {
							"color": "green",
							"command": "pnpm --filter @demos/tracker dev:www"
						},
						"api": {
							"color": "blue",
							"command": "pnpm --filter @demos/tracker dev:api"
						}
					}
				}
			}
		},
		"ci": {
			"tasks": {
				"format": {
					"command": "pnpm format"
				},
				"lint": {
					"command": "pnpm lint",
					"dependsOn": ["ci:format"]
				},
				"check": {
					"command": "pnpm check",
					"dependsOn": ["ci:lint"]
				}
			}
		}
	}
}
