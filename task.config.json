{
	"$schema": "https://getbizi.dev/schemas/task.config.json",
	"tasks": {
		"dev": {
			"tasks": {
				"generate": {
					"color": "white",
					"cwd": "./apps/docs",
					"command": "pnpm generate"
				},
				"velite": {
					"color": "yellow",
					"cwd": "./apps/docs",
					"command": "pnpm generate --watch",
					"dependsOn": ["dev:generate"]
				},
				"web": {
					"color": "cyan",
					"cwd": "./apps/docs",
					"command": "pnpm exec vite",
					"dependsOn": ["dev:generate"]
				}
			}
		},
		"ci": {
			"tasks": {
				"format": {
					"command": "pnpm format"
				},
				"lint": {
					"command": "pnpm lint",
					"dependsOn": ["ci:format"]
				},
				"check": {
					"command": "pnpm check",
					"dependsOn": ["ci:lint"]
				},
				"test": {
					"command": "pnpm test",
					"dependsOn": ["ci:check"]
				}
			}
		}
	}
}
